# Smart Computer Lab Data Logger — Environment Variables
# Copy this file to .env and fill in your actual values.

# ─── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_lab
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# ─── First Admin (created on first run if no admin exists) ──────────────────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_this_password

# ─── Terminal Identity (set this on each physical lab PC) ───────────────────
# Format: LAB-PC-01 through LAB-PC-40
# Leave blank on a shared/central server; clients use ?pc= URL param.
COMPUTER_ID=
